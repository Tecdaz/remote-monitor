<resources>

    <!-- Base theme for the collector app. NoActionBar keeps the Compose
         surface edge-to-edge on phones/tablets and watches. -->
    <style name="Theme.Watch" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Splash theme for MainActivity. Uses the AndroidX SplashScreen lib. -->
    <style name="MainActivityTheme.Starting" parent="Theme.SplashScreen">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Watch</item>
    </style>
</resources>
